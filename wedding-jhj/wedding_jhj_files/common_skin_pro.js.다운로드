// ✅ 자동재생 관련 안내:
// 이 코드는 브라우저(특히 모바일)&환경에 따라 자동재생이 보장되지 않을 수 있습니다.
// 대부분의 모바일 브라우저(아이폰, 일부 안드로이드)는 사용자 상호작용(터치) 이전 BGM 자동재생을 차단합니다.
// 또, 브라우저 정책이 수시로 변경될 수 있으니 항상 테스트 필요!

$(document).ready(function () {

  // $(window).one('scroll keydown touchstart click', function() {
  //   var bgm = document.getElementById("skin_bgm");
  //   if (bgm && bgm.paused) {
  //     bgm_player(true);
  //   }
  // });

  // 사용자가 BGM 아이콘 클릭시
  $('.card_bgm').click(function () {
    bgm_player(true); // true = 사용자 클릭
  });

  var video = $('#ivideo').get(0);
  if (!video) return;

  // 비디오가 재생 시작될 때 → 영상 소리 우선, BGM 복귀 대상으로 마킹
  // ※ iOS는 video 재생 시 BGM(audio)을 video 'play' 이벤트보다 "먼저" 시스템에서 pause시킴 →
  //   이 시점 bgm.paused 는 이미 true 라, 기존 !bgm.paused 조건으로는 복귀플래그(bgmPausedByVideo)가
  //   절대 안 켜져서 영상 종료 후 복귀 로직이 통째로 skip 됐음(= BGM 안 돌아오던 진짜 원인).
  //   → 사용자가 직접 끄지 않았다면(!userDisabledBgm) 이벤트 순서와 무관하게 무조건 복귀대상으로 마킹한다.
  $(video).on('play', function () {
    var bgm = document.getElementById("skin_bgm");
    if (!userDisabledBgm) {
      bgmPausedByVideo = true;
    }
    if (bgm && !bgm.paused) {
      bgm_player(false); // 아직 재생중이면 정지(영상소리 우선). 이미 iOS가 껐으면 그대로 둠
    }
  });

  // 비디오 일시정지/종료될 때 → 영상 때문에 꺼진 BGM만 다시 ON
  $(video).on('pause ended', function () {
    if (bgmPausedByVideo && !userDisabledBgm) {
      bgmPausedByVideo = false;
      bgm_player(false);
    }
  });

  // 페이지 최초 진입시 BGM 자동재생 시도 (정책에 따라 실패할 수 있음)
  try {
    var bgm = document.getElementById("skin_bgm");
    if (bgm) {
      bgm.muted = false;
      var playPromise = bgm.play();
      if (playPromise !== undefined) {
        playPromise.catch(function (e) {
        });
      }
    }
  } catch (e) {
    // 예외 무시
  }
});

var userDisabledBgm = false;   // 사용자가 직접 꺼둔 상태 플래그
var bgmPausedByVideo = false;  // 영상 이벤트때문에 꺼진 상태 플래그

/**
 * 배경음악 플레이/정지 컨트롤
 * @param {boolean} isUserAction - 사용자의 직접 클릭 여부
 */
function bgm_player(isUserAction) {
  var bgm = document.getElementById("skin_bgm");
  if (!bgm) return;
  bgm.muted = false;

  // ▶️ 재생
  if (bgm.paused) {
    // 영상 이벤트 후 자동재생인데, 사용자가 꺼둔 경우면 실행 중단
    if (!isUserAction && userDisabledBgm) return;

    $(".card_bgm img").attr("src", "/storefarm/card/skin/img/pause.svg");
    var p = bgm.play();
    if (p && p.catch) p.catch(function(){});

    if (isUserAction) userDisabledBgm = false;

  // ⏸ 정지
  } else {
    $(".card_bgm img").attr("src", "/storefarm/card/skin/img/play.svg");
    bgm.pause();

    if (isUserAction) userDisabledBgm = true;
  }
}


