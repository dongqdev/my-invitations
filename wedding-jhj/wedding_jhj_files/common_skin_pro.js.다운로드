var timer;

function showRemaining(end) {
  clearInterval(timer)
  var _second = 1000;
  var _minute = _second * 60;
  var _hour = _minute * 60;
  var _day = _hour * 24;

  var now = new Date();
  var distance = end - now;
  var dis = parseInt(distance / (24 * 60 * 60 * 1000));
  var days = Math.floor(distance / _day);
  var hours = Math.floor((distance % _day) / _hour);
  var minutes = Math.floor((distance % _hour) / _minute);
  var seconds = Math.floor((distance % _minute) / _second);
  var theme_main = $('#theme_main').val();

   if (dis == 0 && hours > 1){
     document.getElementById('wd_d-day').innerHTML ='까지, <span class="b_date theme_1_color" style="color:'+theme_main+' !important;">1</span> 일';
  }else if(dis == 0 ){
    document.getElementById('wd_d-day').innerHTML = '이 <span class="b_date theme_1_color" style="color:'+theme_main+' !important;">오늘입니다.</span>';
  }else if (dis < 0){
    document.getElementById('wd_d-day').innerHTML = '이 <span class="b_date theme_1_color" style="color:'+theme_main+' !important;">지났습니다.</span>';
  }else{
    document.getElementById('wd_d-day').innerHTML = '까지, <span class="b_date theme_1_color" style="color:'+theme_main+' !important;">'+(dis+1)+'</span> 일';
  }


  function updateTimer() {
    var now = new Date();
    var countDate = $('#countDate').val();
    var endTimer = new Date(countDate);

    var distance = endTimer - now;
    if (distance < 0) {
      clearInterval(timer);
      // document.getElementById('wd_d-day').innerHTML = ' ';
      document.getElementById('days').textContent = '0';
      document.getElementById('Hours').textContent = '0';
      document.getElementById('minutes').textContent = '0';
      document.getElementById('seconds').textContent = '0';
      return;
    }else{
      var days = Math.floor(distance / _day);
      var hours = Math.floor((distance % _day) / _hour);
      var minutes = Math.floor((distance % _hour) / _minute);
      var seconds = Math.floor((distance % _minute) / _second);
      var dis = parseInt(distance / (24 * 60 * 60 * 1000));

      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('Hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
    }
  }
  updateTimer();
  var loadFont = $('#font_type').val();
  // $('#invite_wrap *').css('font-family', loadFont);
  $('#invite_wrap *').not('#intro_14, #intro_14 *, #intro_15, #intro_15 *, #intro_16, #intro_16 *, #intro_17, #intro_17 *').css('font-family', loadFont);
  timer = setInterval(updateTimer, 1000);
}


